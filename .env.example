# Optional overrides for the HomeoRemedica web app. Settings use the RAG_ prefix.
# Required: the Qdrant cluster holding the collection built by HomeoRemedica-dataset.
QDRANT_URL=
QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=materia_medica
# Required for chat query embeddings (OpenRouter, voyage-4).
OPENROUTER_API_KEY=
# Required for grounded answer generation (Z.AI, GLM-5.3-Flash).
ZAI_API_KEY=
RAG_MODEL=glm-5.3-flash
RAG_MAX_OUTPUT_TOKENS=4096
