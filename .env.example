# Optional overrides for the HomeoRemedica web service. Settings use the RAG_ prefix.
# The path contains active.json and versioned, verified SQLite releases.
RAG_CORPUS_DIR=artifacts/corpus
# Required for corpus and chat query embeddings (OpenRouter, Qwen3).
OPENROUTER_API_KEY=
# Required for grounded answer generation (Z.AI, GLM-5.3-Flash).
ZAI_API_KEY=
RAG_MODEL=glm-5.3-flash
RAG_MAX_OUTPUT_TOKENS=4096
