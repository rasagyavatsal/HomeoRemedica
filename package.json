{
  "name": "homeoremedica",
  "private": true,
  "version": "9.7.0",
  "description": "HomeoRemedica web chat app",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "start": "node src/server/server.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "eval": "PROMPTFOO_DISABLE_TELEMETRY=1 npx --yes promptfoo@0.124.1 eval --config evals/promptfooconfig.yaml",
    "eval:retrieval": "node evals/retrieval.ts",
    "deploy": "gcloud run deploy homeoremedica --source . --region asia-south1 --project homeoremedica --max-instances 1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
